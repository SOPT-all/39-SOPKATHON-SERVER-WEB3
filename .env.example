# Docker Compose reads .env automatically; Spring Boot requires shell/IDE environment variables.
# Copy this file to .env, then replace both example passwords.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Host connection for IDE/bootRun. Compose connects the app to db:3306 automatically.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=sopkathon
DB_USERNAME=sopkathon
DB_PASSWORD=replace-with-local-password
DB_ROOT_PASSWORD=replace-with-local-root-password
