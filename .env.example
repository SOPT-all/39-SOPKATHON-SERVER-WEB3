# Compose는 .env 자동 로딩, Spring Boot는 터미널 또는 IDE 환경변수 설정
# .env로 복사 후 DB 비밀번호 변경
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# IDE 또는 bootRun 실행 시 사용할 DB 접속 정보
DB_HOST=localhost
DB_PORT=3307
DB_NAME=sopkathon
DB_USERNAME=sopkathon
DB_PASSWORD=replace-with-local-password
DB_ROOT_PASSWORD=replace-with-local-root-password
