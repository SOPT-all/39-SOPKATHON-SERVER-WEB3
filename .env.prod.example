# EC2에서 .env로 복사 후 운영 DB 비밀번호 변경
# EC2 외부에서 빌드한 이미지의 커밋 태그 또는 다이제스트
APP_IMAGE=your-dockerhub-username/sopkathon:replace-with-commit-sha
DB_NAME=sopkathon
DB_USERNAME=sopkathon
DB_PASSWORD=replace-with-production-password
DB_ROOT_PASSWORD=replace-with-production-root-password

# 최초 실행은 HTTP, 인증서 발급 전 _를 사용할 도메인으로 변경
DOMAIN=_
NGINX_TEMPLATE=http.conf.template

# 인증서 발급 후 NGINX_TEMPLATE=https.conf.template으로 변경
# COMPOSE_PROFILES=https 설정 시 인증서 자동 갱신 활성화
COMPOSE_PROFILES=
